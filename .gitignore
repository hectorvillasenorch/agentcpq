# 📌 Ignore Python bytecode files
__pycache__/
*.py[cod]
*$py.class

# 📌 Ignore Virtual Environment
venv/
.env

# 📌 Ignore Django & Database files
db.sqlite3
*.sqlite3
*.log

# 📌 Ignore Django migration bytecode/cache (keep migration files tracked)
**/migrations/__pycache__/

# 📌 Ignore IDE/editor files
.vscode/
.idea/
*.swp
*.swo
*.swn

# 📌 Ignore MacOS system files
.DS_Store

# 📌 Ignore compiled C files
*.so

# 📌 Ignore Jupyter Notebook checkpoints (if used)
.ipynb_checkpoints/

# 📌 Ignore static and media files (optional)
staticfiles/

/media/*
!/media/img/

# Local rollback backups
.ui_backup_*/

# Node
node_modules/
frontend/node_modules/

# Local dev settings
agentcpq/settings_local.py
